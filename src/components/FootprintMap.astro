---
import data from '../data/portfolio.json';
import { L, t, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const T = t(lang).footprint;
const { footprint } = data;

type Country = { name: any; lat: number; lng: number; iso?: string; region?: string; hq?: boolean };
const places = (footprint.places as any[]).map((p) => ({
  id: p.id, type: p.type, anchor: p.anchor,
  // Una operación puede abarcar varias regiones (region: "multi"): cada país trae la suya
  regions: p.region === 'multi' ? [...new Set((p.countries as Country[]).map((c) => c.region!))] : [p.region],
  name: L(p.name, lang) as string, note: L(p.note, lang) as string,
  countries: (p.countries as Country[]).map((c) => ({ ...c, name: L(c.name, lang) as string })),
}));
const regions = footprint.regions.filter((r) => places.some((p) => p.regions.includes(r.id)));

// Países únicos con operaciones o apoyo (excluye sedes académicas y la sede de Roma)
const supported = new Set(places.filter((p) => p.type !== 'academic' && p.id !== 'rome').flatMap((p) => p.countries.filter((c) => !c.hq).map((c) => c.name)));
const lead = T.leadCount.replace('{n}', String(supported.size));
---
<section class="section" id="footprint">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{T.eyebrow}</span>
      <h2 class="section-title" set:html={T.title} />
      <p class="section-lead">{T.lead} <strong class="count">{lead}</strong></p>
    </div>

    <div class="map-shell reveal">
      <div class="map-wrap">
        <div id="footprint-map" class="map" data-places={JSON.stringify(places)} role="region" aria-label={T.aria}>
          <div class="map-placeholder" aria-hidden="true"><span>{T.loading}</span></div>
        </div>
        <ul class="legend">
          {Object.entries(T.types).map(([k, v]) => <li><span class={`sw ${k}`}></span>{v}</li>)}
        </ul>
      </div>

      <aside class="panel">
        <div class="tabs" role="tablist" aria-label={T.filter}>
          <button role="tab" aria-selected="true" data-region="all">{T.all}</button>
          {regions.map((r) => <button role="tab" aria-selected="false" data-region={r.id}>{L(r.name, lang)}</button>)}
        </div>
        <ol class="places">
          {places.map((p, i) => (
            <li data-region={p.regions.join(' ')}>
              <button data-place={i}>
                <span class={`sw ${p.type}`} aria-hidden="true"></span>
                <span class="pl">
                  <strong>{p.name}{p.countries.length > 1 && <em class="n mono-num">{p.countries.length}</em>}</strong>
                  <span>{p.note}</span>
                  {p.countries.length > 1 && <small>{p.countries.map((c) => c.name).join(' · ')}</small>}
                </span>
              </button>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </div>
</section>

<style>
  .count { font-weight: 700; color: var(--accent); white-space: nowrap; }
  .map-shell { display: grid; grid-template-columns: minmax(0, 1fr) 340px; border: 1px solid var(--line-soft); border-radius: var(--radius); overflow: hidden; background: var(--bg-elev); }
  .map-wrap { position: relative; }
  .map { height: clamp(400px, 54vw, 600px); background: var(--bg-elev); }
  :global(#footprint-map.leaflet-container) { background: var(--bg-elev); }
  .map-placeholder { height: 100%; display: grid; place-items: center; color: var(--muted); font-size: 0.875rem;
    background-image: radial-gradient(var(--line) 1px, transparent 1px); background-size: 22px 22px; }
  .legend { position: absolute; left: 14px; bottom: 14px; z-index: 500; display: grid; gap: 6px; padding: 10px 12px; border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(6px); border: 1px solid var(--line-soft); font-size: 0.75rem; color: var(--text-2); }
  .legend li { display: flex; align-items: center; gap: 8px; }
  .sw { flex: none; width: 10px; height: 10px; border-radius: 50%; border: 2px solid; }
  .sw.lead { border-color: var(--accent); background: var(--accent-soft); }
  .sw.regional { border-color: var(--tech); background: var(--tech-soft); }
  .sw.academic { border-color: var(--warm); background: transparent; }

  .panel { border-left: 1px solid var(--line-soft); display: flex; flex-direction: column; min-height: 0; max-height: clamp(400px, 54vw, 600px); }
  .tabs { display: flex; align-items: center; flex: none; gap: 4px; padding: 12px; border-bottom: 1px solid var(--line-soft); overflow-x: auto; overflow-y: hidden; scrollbar-width: none; }
  .tabs::-webkit-scrollbar { display: none; }
  .tabs button { flex: 0 0 auto; padding: 8px 10px; white-space: nowrap; border-radius: 8px; font-size: 0.8125rem; color: var(--text-2); }
  .tabs button[aria-selected='true'] { background: var(--surface-2); color: var(--text); font-weight: 700; }
  .places { list-style: none; margin: 0; padding: 6px; overflow-y: auto; }
  .places li[hidden] { display: none; }
  .places button { width: 100%; display: flex; gap: 12px; align-items: flex-start; text-align: left; padding: 10px; border-radius: 8px; }
  .places button:hover, .places button.is-active { background: var(--surface); }
  .places .sw { margin-top: 6px; }
  .pl { display: grid; gap: 2px; }
  .pl strong { font-size: 0.9rem; display: flex; align-items: center; gap: 8px; }
  .pl .n { font-style: normal; font-size: 0.6875rem; font-weight: 700; padding: 1px 7px; border-radius: 999px; background: var(--surface-2); color: var(--text-2); }
  .pl span { font-size: 0.8125rem; color: var(--muted); line-height: 1.45; }
  .pl small { font-size: 0.75rem; color: var(--text-2); line-height: 1.5; margin-top: 2px; }

  @media (max-width: 900px) {
    .map-shell { grid-template-columns: 1fr; }
    .panel { border-left: 0; border-top: 1px solid var(--line-soft); max-height: 360px; }
    .map { height: 400px; }
  }

  :global(.leaflet-container) { font-family: var(--font); background: var(--bg-elev); }
  :global(.leaflet-control-zoom a) { background: var(--surface) !important; color: var(--text) !important; border-color: var(--line) !important; }
  :global(.leaflet-control-attribution) { background: color-mix(in srgb, var(--bg) 75%, transparent) !important; color: var(--muted) !important; font-size: 10px; }
  :global(.leaflet-control-attribution a) { color: var(--text-2) !important; }
  :global(.leaflet-tooltip.fp-tip) { background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow); padding: 8px 10px; font-size: 0.8125rem; max-width: 260px; white-space: normal; }
  :global(.leaflet-tooltip.fp-tip::before) { display: none; }
  :global(.fp-tip strong) { display: block; font-size: 0.875rem; margin-bottom: 2px; }
  :global(.fp-tip span) { display: block; color: var(--text-2); }
  :global(.fp-pulse) { animation: fpPulse 2.8s ease-out infinite; transform-origin: center; transform-box: fill-box; }
  @keyframes fpPulse { 0% { opacity: 0.55; transform: scale(1); } 100% { opacity: 0; transform: scale(3.2); } }
</style>

<script>
  import worldUrl from 'world-atlas/countries-110m.json?url';

  type Kind = 'lead' | 'regional' | 'academic';
  type Country = { name: string; lat: number; lng: number; iso?: string; region?: string };
  type Place = { id: string; name: string; note: string; regions: string[]; type: Kind; anchor: [number, number]; countries: Country[] };

  const el = document.getElementById('footprint-map')!;
  const places: Place[] = JSON.parse(el.dataset.places || '[]');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('#footprint button[data-region]')];
  const items = [...document.querySelectorAll<HTMLLIElement>('#footprint .places li')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#footprint [data-place]')];
  const rank: Record<Kind, number> = { lead: 3, regional: 2, academic: 1 };
  const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
  const color = (k: Kind) => (k === 'lead' ? css('--accent') : k === 'regional' ? css('--tech') : css('--warm'));

  // Un punto por país (deduplicado): conserva el tipo de mayor rango y todas las operaciones que lo cubren
  type Dot = { key: string; c: Country; type: Kind; regions: Set<string>; places: number[] };
  const dots = new Map<string, Dot>();
  places.forEach((p, i) => p.countries.forEach((c) => {
    const key = c.iso ?? c.name;
    const d = dots.get(key) ?? { key, c, type: p.type, regions: new Set<string>(), places: [] };
    if (rank[p.type] > rank[d.type]) d.type = p.type;
    d.regions.add(c.region ?? p.regions[0]); d.places.push(i);
    dots.set(key, d);
  }));

  async function boot() {
    const [{ default: L }, { feature }, topo] = await Promise.all([
      import('leaflet'),
      import('topojson-client'),
      fetch(worldUrl).then((r) => r.json()),
      import('leaflet/dist/leaflet.css'),
    ]);
    el.innerHTML = '';
    const map = L.map(el, {
      scrollWheelZoom: false, zoomSnap: 0.25, minZoom: 1.5, maxZoom: 7,
      maxBounds: [[-75, -200], [85, 200]], attributionControl: true,
    });
    map.attributionControl.setPrefix('').addAttribution('Natural Earth');

    // Sombreado de países por el tipo de mayor rango
    const isoType = new Map<string, Kind>();
    dots.forEach((d) => { if (d.c.iso) isoType.set(d.c.iso, d.type); });
    const world = feature(topo, topo.objects.countries) as any;
    const countryStyle = (f: any) => {
      const k = isoType.get(f.id);
      return k
        ? { color: color(k), weight: 0.9, fillColor: color(k), fillOpacity: k === 'academic' ? 0.1 : 0.22 }
        : { color: css('--line'), weight: 0.6, fillColor: css('--surface-2'), fillOpacity: 1 };
    };
    const countries = L.geoJSON(world, { style: countryStyle, interactive: false }).addTo(map);

    // Arcos: de la base (Bogotá) al ancla de cada operación
    const hub = places[0].anchor;
    const arcs = L.layerGroup().addTo(map);
    const drawArcs = (subset = places.slice(1)) => {
      arcs.clearLayers();
      subset.filter((p) => p !== places[0]).forEach((p) => {
        const [la, ln] = p.anchor;
        const mid = [(hub[0] + la) / 2 + Math.abs(hub[1] - ln) * 0.12, (hub[1] + ln) / 2];
        const pts: [number, number][] = [];
        for (let s = 0; s <= 1.0001; s += 0.05) {
          pts.push([(1 - s) ** 2 * hub[0] + 2 * (1 - s) * s * mid[0] + s ** 2 * la, (1 - s) ** 2 * hub[1] + 2 * (1 - s) * s * mid[1] + s ** 2 * ln]);
        }
        L.polyline(pts, { color: css('--text'), opacity: 0.12, weight: 1, dashArray: '2 5', interactive: false }).addTo(arcs);
      });
    };
    drawArcs();

    const dotLayers = [...dots.values()].map((d) => {
      const g = L.layerGroup();
      const c = color(d.type);
      if (d.type === 'lead' && d.c.iso) {
        L.circleMarker([d.c.lat, d.c.lng], { radius: 5, color: c, weight: 1, fillOpacity: 0, className: 'fp-pulse', interactive: false }).addTo(g);
      }
      const html = `<strong>${d.c.name}</strong>` + d.places.map((i) => `<span>${places[i].name} — ${places[i].note}</span>`).join('');
      L.circleMarker([d.c.lat, d.c.lng], {
        radius: d.c.iso ? 5 : 3.5, color: c, weight: 1.6, fillColor: c, fillOpacity: d.type === 'academic' ? 0 : 0.35,
      }).bindTooltip(html, { className: 'fp-tip', direction: 'top', offset: [0, -6] }).addTo(g);
      g.addTo(map);
      return { d, g };
    });

    const bounds = (pts: [number, number][], pad: number) => L.latLngBounds(pts).pad(pad);
    const allPts = [...dots.values()].map((d) => [d.c.lat, d.c.lng] as [number, number]);
    map.fitBounds(bounds(allPts, 0.12), { maxZoom: 5 });

    function focus(i: number) {
      const p = places[i];
      const pts = p.countries.map((c) => [c.lat, c.lng] as [number, number]);
      if (pts.length > 1) map.flyToBounds(bounds(pts, 0.35), { maxZoom: 6, duration: 0.8 });
      else map.flyTo(pts[0], Math.max(map.getZoom(), 5), { duration: 0.8 });
      buttons.forEach((b) => b.classList.toggle('is-active', Number(b.dataset.place) === i));
    }
    buttons.forEach((b) => b.addEventListener('click', () => focus(Number(b.dataset.place))));

    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const r = tab.dataset.region!;
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === tab)));
      items.forEach((li) => (li.hidden = r !== 'all' && !li.dataset.region!.split(' ').includes(r)));
      const shown = dotLayers.filter(({ d }) => r === 'all' || d.regions.has(r));
      dotLayers.forEach(({ g }) => g.remove()); shown.forEach(({ g }) => g.addTo(map));
      drawArcs(r === 'all' ? places : places.filter((p) => p.regions.includes(r)));
      const pts = shown.map(({ d }) => [d.c.lat, d.c.lng] as [number, number]);
      if (pts.length) map.flyToBounds(bounds(pts, pts.length > 3 ? 0.15 : 0.6), { maxZoom: 5, duration: 0.8 });
    }));

    document.addEventListener('themechange', () => {
      countries.setStyle(countryStyle);
      dotLayers.forEach(({ d, g }) => g.eachLayer((l: any) => l.setStyle?.({ color: color(d.type), fillColor: color(d.type) })));
      drawArcs();
    });
  }

  const io = new IntersectionObserver((entries) => {
    if (entries.some((e) => e.isIntersecting)) { io.disconnect(); boot(); }
  }, { rootMargin: '300px 0px' });
  io.observe(el);
</script>
