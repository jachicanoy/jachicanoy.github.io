---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import data from '../data/portfolio.json';
import { workImage } from '../data/images';
import { L, t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const T = t(lang).projects;
const { projects, stack } = data;

const techName = new Map(stack.domains.flatMap((d) => d.items.map((i) => [i.id, L(i.name as any, lang) as string] as const)));
const regionName: Record<string, string> = { latam: 'LAC', africa: lang === 'es' ? 'África' : 'Africa', europe: lang === 'es' ? 'Europa' : 'Europe', global: 'Global', asia: 'Asia' };
const ordered = [...projects].sort((a, b) => Number(b.featured) - Number(a.featured));
---
<section class="section" id="projects">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{T.eyebrow}</span>
      <h2 class="section-title" set:html={T.title} />
      <p class="section-lead">{T.lead}</p>
    </div>

    <span hidden data-filter-i18n data-one={T.one} data-many={T.many} data-with={T.with}></span>
    <div class="filter-status" data-filter-status="projects" hidden role="status" aria-live="polite">
      <span class="pulse" aria-hidden="true"></span>
      <span data-filter-label></span>
      <button class="clear" data-filter-clear><Icon name="close" size={14} /> {T.clear}</button>
    </div>

    <div class="grid">
      {ordered.map((p: any) => {
        const img = workImage(p.image);
        return (
          <article class:list={['card', { featured: p.featured }]} data-item data-group="projects" data-tech={p.tech.join(' ')}>
            {img && <Image src={img} alt="" class="thumb" widths={[480, 800]} sizes="(max-width: 640px) 100vw, 400px" loading="lazy" />}
            <header>
              <div class="meta">
                <span class="region">{regionName[p.region] ?? p.region}</span>
                <span class="sep" aria-hidden="true">/</span>
                <span>{L(p.country, lang)}</span>
                <span class="year mono-num">{p.year}</span>
              </div>
              <h3>{L(p.title, lang)}</h3>
              <p class="subtitle">{L(p.subtitle, lang)}</p>
            </header>
            <p class="desc">{L(p.description, lang)}</p>
            {p.metrics.length > 0 && (
              <dl class="metrics">
                {p.metrics.map((m: any) => (<div><dt>{L(m.label, lang)}</dt><dd>{L(m.value, lang)}</dd></div>))}
              </dl>
            )}
            <footer>
              <ul class="tech-list" aria-label={T.techs}>
                {p.tech.map((x: string) => (
                  <li><button class="chip tech-chip" data-chip-tech={x}>{techName.get(x) ?? x}</button></li>
                ))}
              </ul>
              <div class="row">
                <span class="org"><Icon name="layers" size={15} /> {L(p.org, lang)}</span>
                {p.links.length > 0 && (
                  <div class="links">
                    {p.links.map((l: any) => (
                      <a href={l.url} target="_blank" rel="noopener">{L(l.label, lang)} <Icon name="external" size={14} /></a>
                    ))}
                  </div>
                )}
              </div>
            </footer>
          </article>
        );
      })}
      <p class="empty" data-filter-empty="projects" hidden>{T.none}</p>
    </div>
  </div>

  <a href="#projects" class="toast" data-filter-toast hidden>
    <span data-toast-label></span> <Icon name="arrow" size={16} />
  </a>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .card {
    grid-column: span 2; display: flex; flex-direction: column; gap: 18px; overflow: hidden;
    padding: clamp(22px, 2.4vw, 30px); border-radius: var(--radius);
    background: var(--bg-elev); border: 1px solid var(--line-soft); box-shadow: var(--shadow);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease), background 0.3s;
    animation: fade 0.45s var(--ease);
  }
  .card.featured { grid-column: span 3; }
  .card:hover { border-color: var(--line); transform: translateY(-2px); background: var(--surface); }
  .card[hidden] { display: none; }
  @keyframes fade { from { opacity: 0; transform: translateY(6px); } }
  :global(.card .thumb) {
    margin: calc(-1 * clamp(22px, 2.4vw, 30px)) calc(-1 * clamp(22px, 2.4vw, 30px)) 0;
    width: calc(100% + 2 * clamp(22px, 2.4vw, 30px)); max-width: none; height: 160px; object-fit: cover; object-position: top;
    border-bottom: 1px solid var(--line-soft);
  }

  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.75rem; color: var(--muted); letter-spacing: 0.04em; }
  .region { color: var(--warm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; }
  .year { margin-left: auto; }
  .card h3 { margin-top: 14px; font-size: clamp(1.2rem, 1.8vw, 1.45rem); font-weight: 700; }
  .subtitle { margin-top: 4px; color: var(--accent); font-size: 0.9375rem; }
  .desc { color: var(--text-2); font-weight: 300; font-size: 0.95rem; line-height: 1.65; }
  .metrics { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 1px; background: var(--line-soft); border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--line-soft); }
  .metrics div { background: var(--bg-elev); padding: 10px 12px; }
  .card:hover .metrics div { background: var(--surface); }
  .metrics dt { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); }
  .metrics dd { margin: 2px 0 0; font-size: 0.875rem; font-weight: 700; }
  footer { margin-top: auto; display: grid; gap: 16px; }
  .tech-list { display: flex; flex-wrap: wrap; gap: 6px; }
  .tech-chip { cursor: pointer; transition: border-color 0.2s, color 0.2s, background 0.2s; }
  .tech-chip:hover { border-color: var(--line); color: var(--text); }
  .tech-chip.is-active { background: var(--accent-soft); border-color: var(--accent-line); color: var(--text); }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding-top: 14px; border-top: 1px solid var(--line-soft); }
  .org { display: inline-flex; align-items: center; gap: 8px; font-size: 0.8125rem; color: var(--muted); }
  .links { display: flex; gap: 14px; flex-wrap: wrap; }
  .links a { display: inline-flex; align-items: center; gap: 6px; font-size: 0.8125rem; font-weight: 700; color: var(--accent); }
  .links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .empty { grid-column: 1 / -1; color: var(--muted); padding: 32px 0; }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .card, .card.featured { grid-column: span 1; }
  }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
