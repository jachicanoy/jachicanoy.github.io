---
import data from '../data/portfolio.json';
import { L, t, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const T = t(lang).experience;
const { experience } = data;
---
<section class="section" id="experience">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{T.eyebrow}</span>
      <h2 class="section-title" set:html={T.title} />
      <p class="section-lead">{T.lead}</p>
    </div>

    <ol class="timeline">
      {experience.map((e) => (
        <li class:list={['item reveal', { current: e.current }]}>
          <span class="node" aria-hidden="true"></span>
          <details open={e.current}>
            <summary>
              <span class="period mono-num">{L(e.period, lang)}</span>
              <span class="main">
                <span class="org">{e.org}</span>
                <span class="role">{L(e.role, lang)}</span>
              </span>
              <span class="loc">{L(e.location, lang)}</span>
              <span class="toggle" aria-hidden="true"></span>
            </summary>
            <div class="body">
              <ul>{L(e.highlights, lang).map((h) => <li>{h}</li>)}</ul>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 7px; top: 8px; bottom: 8px; width: 1px; background: linear-gradient(var(--accent-line), var(--line) 30%, var(--line-soft)); }
  .item { position: relative; padding-left: 40px; }
  .node { position: absolute; left: 0; top: 30px; width: 15px; height: 15px; border-radius: 50%; background: var(--bg); border: 1px solid var(--line); }
  .item.current .node { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .item.current .node::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--accent); }

  details { border-bottom: 1px solid var(--line-soft); }
  summary {
    list-style: none; cursor: pointer; display: grid; grid-template-columns: 170px minmax(0, 1fr) auto 24px; gap: 20px; align-items: center;
    padding: 22px 0;
  }
  summary::-webkit-details-marker { display: none; }
  .period { font-size: 0.8125rem; color: var(--muted); letter-spacing: 0.02em; }
  .main { display: grid; gap: 2px; }
  .org { font-size: 1.15rem; font-weight: 700; transition: color 0.2s; }
  .role { color: var(--text-2); font-weight: 300; }
  .loc { font-size: 0.8125rem; color: var(--muted); text-align: right; }
  .toggle { position: relative; width: 14px; height: 14px; justify-self: end; }
  .toggle::before, .toggle::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--text-2); transition: transform 0.25s var(--ease); }
  .toggle::after { transform: rotate(90deg); }
  details[open] .toggle::after { transform: rotate(0); }
  summary:hover .org { color: var(--accent); }
  .body { padding: 0 0 26px calc(170px + 20px); display: grid; gap: 12px; animation: open 0.35s var(--ease); }
  @keyframes open { from { opacity: 0; transform: translateY(-4px); } }
  .body ul { list-style: none; padding: 0; display: grid; gap: 8px; }
  .body li { position: relative; padding-left: 18px; color: var(--text-2); font-weight: 300; }
  .body li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 8px; height: 1px; background: var(--accent); }

  @media (max-width: 760px) {
    .item { padding-left: 32px; }
    summary { grid-template-columns: minmax(0, 1fr) 20px; gap: 6px 12px; padding: 18px 0; }
    .period { grid-column: 1; order: -1; }
    .main { grid-column: 1; }
    .loc { grid-column: 1; text-align: left; }
    .toggle { grid-row: 1 / span 3; grid-column: 2; align-self: center; }
    .node { top: 24px; }
    .body { padding-left: 0; }
  }
</style>
