---
import DashShell from './DashShell.astro';
import data from '../../data/dashboards/afghanistan.json';
import type { Lang } from '../../i18n';

const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
const nf = new Intl.NumberFormat(es ? 'es-CO' : 'en-US');
const df = (n: number, d = 1) => new Intl.NumberFormat(es ? 'es-CO' : 'en-US', { maximumFractionDigits: d }).format(n);

const sectors = es
  ? { all: 'Todos los sectores', fsa: 'Seguridad alimentaria y agricultura', hea: 'Salud', pro: 'Protección', wsh: 'Agua, saneamiento e higiene', shl: 'Alojamiento y artículos no alimentarios', nut: 'Nutrición', edu: 'Educación en emergencias' }
  : { all: 'All sectors', fsa: 'Food security & agriculture', hea: 'Health', pro: 'Protection', wsh: 'Water, sanitation & hygiene', shl: 'Emergency shelter & NFI', nut: 'Nutrition', edu: 'Education in emergencies' };
const types: Record<string, string> = es
  ? { Battles: 'Combates', 'Explosions/Remote violence': 'Explosiones / violencia remota', 'Violence against civilians': 'Violencia contra civiles', 'Strategic developments': 'Desarrollos estratégicos', Protests: 'Protestas', Riots: 'Disturbios' }
  : {};
const informL = es
  ? { 'HAZARD & EXPOSURE': 'Amenaza y exposición', VULNERABILITY: 'Vulnerabilidad', 'LACK OF COPING CAPACITY': 'Falta de capacidad de respuesta', 'INFORM RISK': 'Riesgo INFORM' }
  : { 'HAZARD & EXPOSURE': 'Hazard & exposure', VULNERABILITY: 'Vulnerability', 'LACK OF COPING CAPACITY': 'Lack of coping capacity', 'INFORM RISK': 'INFORM risk' };

const k = data.kpi;
const pinTotal = data.hno.provinces.reduce((a, p: any) => a + p.all, 0);
const T = es
  ? {
      eyebrow: 'Tablero · Perfil de país',
      title: 'Afganistán: perfil humanitario y de desarrollo',
      lead: 'Reconstrucción nativa de un perfil de país en Power BI: indicadores de desarrollo, personas con necesidades por sector y provincia, desplazamiento, conflicto y riesgo.',
      note: 'Muestra de trabajo personal con datos públicos. Instantánea histórica: indicadores del Banco Mundial 2018, HNO 2020 (revisión de mitad de año), desplazamiento ene–jun 2020 y conflicto 2017–2020.',
      kpi: ['Población (millones)', 'Pobreza (línea nacional)', 'Esperanza de vida', 'Mortalidad < 5 (por 1.000)', 'INB per cápita (US$)', 'Personas con necesidades'],
      years: 'años',
      sector: 'Sector', bySector: 'Personas con necesidades por sector', bySectorSub: 'HNO 2020 (revisado)',
      byProv: 'Provincias con más personas con necesidades', byProvSub: 'Top 15 · sector seleccionado',
      idps: 'Nuevos desplazados internos por provincia de llegada', idpsSub: 'Top 10 · enero–junio 2020',
      cYear: 'Eventos de conflicto por año', cYearSub: '2020 parcial', cType: 'Eventos de conflicto por tipo', cTypeSub: '2017–2020',
      inform: 'Índice de riesgo INFORM', informSub: 'Escala 0–10 · 2020', events: 'eventos', fatal: 'víctimas mortales', table: 'Ver tabla', prov: 'Provincia', value: 'Valor',
    }
  : {
      eyebrow: 'Dashboard · Country profile',
      title: 'Afghanistan: humanitarian & development profile',
      lead: 'Native rebuild of a Power BI country profile: development indicators, people in need by sector and province, displacement, conflict and risk.',
      note: 'Personal work sample on public data. Historical snapshot: World Bank indicators 2018, HNO 2020 (mid-year revision), displacement Jan–Jun 2020 and conflict 2017–2020.',
      kpi: ['Population (millions)', 'Poverty (national line)', 'Life expectancy', 'Under-5 mortality (per 1,000)', 'GNI per capita (US$)', 'People in need'],
      years: 'years',
      sector: 'Sector', bySector: 'People in need by sector', bySectorSub: 'HNO 2020 (revised)',
      byProv: 'Provinces with most people in need', byProvSub: 'Top 15 · selected sector',
      idps: 'New IDPs by province of arrival', idpsSub: 'Top 10 · January–June 2020',
      cYear: 'Conflict events by year', cYearSub: '2020 partial', cType: 'Conflict events by type', cTypeSub: '2017–2020',
      inform: 'INFORM risk index', informSub: '0–10 scale · 2020', events: 'events', fatal: 'fatalities', table: 'View table', prov: 'Province', value: 'Value',
    };
const view = {
  provinces: data.hno.provinces,
  sectors,
  idps: data.idps.byProvince,
  byYear: data.conflict.byYear,
  byType: data.conflict.byType.map((t: any) => ({ ...t, label: types[t.type] ?? t.type })),
  inform: Object.entries(data.inform).map(([kk, v]) => ({ label: (informL as any)[kk] ?? kk, value: v })),
};
---
<DashShell
  lang={lang} slug="afghanistan" eyebrow={T.eyebrow} title={T.title} lead={T.lead} note={T.note}
  sources={[
    { label: 'World Bank — World Development Indicators', url: 'https://databank.worldbank.org/source/world-development-indicators' },
    { label: 'OCHA — Afghanistan HNO 2020 (HDX)', url: 'https://data.humdata.org/group/afg' },
    { label: 'IOM / OCHA — Conflict-induced displacement (HDX)', url: 'https://data.humdata.org/group/afg' },
    { label: es ? 'ACLED — conteos agregados' : 'ACLED — aggregated counts', url: 'https://acleddata.com' },
    { label: 'INFORM Risk Index', url: 'https://drmkc.jrc.ec.europa.eu/inform-index' },
  ]}
>
  <div id="afg" data-view={JSON.stringify(view)} data-t={JSON.stringify(T)} data-lang={lang}>
    <div class="kpis">
      <div class="kpi"><b>{df(k.population_m)}</b><span>{T.kpi[0]}</span></div>
      <div class="kpi"><b>{df(k.poverty_pct)}%</b><span>{T.kpi[1]}</span></div>
      <div class="kpi"><b>{df(k.life_expectancy, 0)}</b><span>{T.kpi[2]} ({T.years})</span></div>
      <div class="kpi"><b>{df(k.u5_mortality, 0)}</b><span>{T.kpi[3]}</span></div>
      <div class="kpi"><b>{nf.format(k.gni_pc)}</b><span>{T.kpi[4]}</span></div>
      <div class="kpi"><b>{df(pinTotal / 1e6)} M</b><span>{T.kpi[5]}</span></div>
    </div>

    <div class="grid2">
      <section class="ccard"><h2>{T.bySector}</h2><p class="sub">{T.bySectorSub}</p><div class="chart" id="a-sector"></div></section>
      <section class="ccard">
        <h2>{T.byProv}</h2><p class="sub">{T.byProvSub}</p>
        <div class="filters" style="margin:0"><label for="afg-sector">{T.sector}</label>
          <select id="afg-sector">{Object.entries(sectors).map(([kk, v]) => <option value={kk}>{v}</option>)}</select>
        </div>
        <div class="chart" id="a-prov"></div>
        <details><summary>{T.table}</summary>
          <table><thead><tr><th>{T.prov}</th><th class="n">{sectors.all}</th></tr></thead>
            <tbody>{[...data.hno.provinces].sort((a: any, b: any) => b.all - a.all).map((p: any) => <tr><td>{p.name}</td><td class="n">{nf.format(p.all)}</td></tr>)}</tbody></table>
        </details>
      </section>
      <section class="ccard"><h2>{T.idps}</h2><p class="sub">{T.idpsSub} · {nf.format(data.idps.total)}</p><div class="chart" id="a-idps"></div></section>
      <section class="ccard"><h2>{T.inform}</h2><p class="sub">{T.informSub}</p><div class="chart" id="a-inform"></div></section>
      <section class="ccard"><h2>{T.cYear}</h2><p class="sub">{T.cYearSub}</p><div class="chart" id="a-year"></div></section>
      <section class="ccard"><h2>{T.cType}</h2><p class="sub">{T.cTypeSub}</p><div class="chart" id="a-type"></div></section>
    </div>
  </div>
</DashShell>

<script>
  import { hbars, columns, responsive, compact, full } from '../../scripts/charts';
  const root = document.getElementById('afg')!;
  const V = JSON.parse(root.dataset.view!);
  const T = JSON.parse(root.dataset.t!);
  const lang = root.dataset.lang!;
  const cfmt = compact(lang), ffmt = full(lang);
  const one = new Intl.NumberFormat(lang === 'es' ? 'es-CO' : 'en-US', { maximumFractionDigits: 1 });
  const sel = root.querySelector<HTMLSelectElement>('#afg-sector')!;
  const $ = (id: string) => root.querySelector<HTMLElement>(id)!;
  const keys = Object.keys(V.sectors).filter((k) => k !== 'all');

  function draw() {
    const sum = (k: string) => V.provinces.reduce((a: number, p: any) => a + (p[k] ?? 0), 0);
    hbars($('#a-sector'), keys.map((k) => ({ label: V.sectors[k], a: sum(k) })).sort((a, b) => b.a - a.a), { fmt: cfmt, labelW: 190 });
    const k = sel.value || 'all';
    hbars($('#a-prov'), [...V.provinces].sort((a: any, b: any) => b[k] - a[k]).slice(0, 15).map((p: any) => ({ label: p.name, a: p[k] })), { fmt: cfmt });
    hbars($('#a-idps'), V.idps.map((d: any) => ({ label: d.name, a: d.value })), { fmt: ffmt });
    hbars($('#a-inform'), V.inform.map((d: any) => ({ label: d.label, a: d.value })), { fmt: (n) => one.format(n), labelW: 190, max: 10 });
    columns($('#a-year'), V.byYear.map((d: any) => ({ label: String(d.year), a: d.events, b: d.fatalities })), {
      fmt: ffmt, label: (d) => `${ffmt(d.a)} ${T.events} · ${ffmt(d.b ?? 0)} ${T.fatal}`,
    });
    hbars($('#a-type'), V.byType.map((d: any) => ({ label: d.label, a: d.value })), { fmt: ffmt, labelW: 200 });
  }
  sel.addEventListener('change', draw);
  responsive(root, draw);
</script>
