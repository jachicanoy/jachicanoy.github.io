---
import Icon from './Icon.astro';
import data from '../data/portfolio.json';
import { L, t, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const T = t(lang).contact;
const { profile, links } = data;
const ok = (u: string) => !!u && !u.includes('TODO');
const strip = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const channels = [
  { label: T.email, value: links.email, href: `mailto:${links.email}`, icon: 'mail' as const, show: ok(links.email) },
  { label: 'LinkedIn', value: strip(links.linkedin), href: links.linkedin, icon: 'linkedin' as const, show: ok(links.linkedin) },
  { label: 'GitHub', value: strip(links.github), href: links.github, icon: 'github' as const, show: ok(links.github) },
  { label: 'Earth Engine Apps', value: 'ee-jersoncatalyst', href: links.gee, icon: 'layers' as const, show: ok(links.gee) },
  { label: 'ORCID', value: strip(links.orcid), href: links.orcid, icon: 'doc' as const, show: ok(links.orcid) },
].filter((c) => c.show);
const year = new Date().getFullYear();
---
<footer class="footer" id="contact">
  <div class="container">
    <div class="cta reveal">
      <span class="eyebrow">{T.eyebrow}</span>
      <h2 set:html={T.title} />
      <a class="btn btn-primary" href={`mailto:${links.email}`}><Icon name="mail" /> {T.cta}</a>
    </div>

    <ul class="channels reveal">
      {channels.map((c) => (
        <li>
          <a href={c.href} {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
            <Icon name={c.icon} size={20} />
            <span><small>{c.label}</small>{c.value}</span>
            <Icon name="arrow" size={16} class="go" />
          </a>
        </li>
      ))}
    </ul>

    <div class="bottom">
      <p>© {year} {profile.name} · {L(profile.location, lang)}</p>
      <p class="muted">{T.built}</p>
    </div>
  </div>
</footer>

<style>
  .footer { padding: var(--section-y) 0 32px; border-top: 1px solid var(--line-soft); background: linear-gradient(var(--bg), var(--bg-elev)); }
  .cta { display: grid; gap: 22px; justify-items: start; max-width: 820px; }
  .cta h2 { font-size: clamp(1.7rem, 4vw, 3rem); font-weight: 300; letter-spacing: -0.025em; line-height: 1.15; }
  .cta :global(strong) { font-weight: 700; color: var(--accent); }
  .channels { margin-top: clamp(48px, 7vw, 72px); display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1px; background: var(--line-soft); border: 1px solid var(--line-soft); border-radius: var(--radius); overflow: hidden; }
  .channels a { display: flex; align-items: center; gap: 14px; padding: 22px; background: var(--bg-elev); color: var(--text-2); transition: background 0.2s, color 0.2s; height: 100%; }
  .channels a:hover { background: var(--surface); color: var(--text); }
  .channels span { display: grid; min-width: 0; font-size: 0.9rem; overflow-wrap: anywhere; }
  .channels small { font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  :global(.channels .go) { margin-left: auto; flex: none; opacity: 0; transform: translateX(-4px); transition: all 0.2s var(--ease); }
  .channels a:hover :global(.go) { opacity: 1; transform: none; color: var(--accent); }
  .bottom { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line-soft); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; font-size: 0.8125rem; color: var(--text-2); }
  .muted { color: var(--muted); }
</style>
